# ===== English LMS – Backend Sprint 1 =====
# Sao chép file này thành server/.env rồi điền giá trị thật. KHÔNG commit file .env.

PORT=8000
NODE_ENV=development
# Domain frontend được phép gọi API (nhiều domain phân tách bằng dấu phẩy)
CLIENT_URL=http://localhost:3000

# MongoDB (MongoDB Atlas hoặc local)
DB_URL=mongodb://127.0.0.1:27017/english-lms
# Redis lưu phiên đăng nhập, OTP (Upstash hoặc local)
REDIS_URL=redis://127.0.0.1:6379

# Khóa ký JWT – đặt chuỗi ngẫu nhiên dài, mỗi khóa khác nhau
ACTIVATION_SECRET=doi_chuoi_ngau_nhien_1
ACCESS_TOKEN=doi_chuoi_ngau_nhien_2
REFRESH_TOKEN=doi_chuoi_ngau_nhien_3
# Thời hạn token: ACCESS tính bằng phút, REFRESH tính bằng ngày
ACCESS_TOKEN_EXPIRE=5
REFRESH_TOKEN_EXPIRE=3

# Gửi email OTP kích hoạt / quên mật khẩu (ví dụ Gmail + App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SERVICE=gmail
SMTP_MAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Cloudinary – lưu ảnh đại diện (US-06)
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
